#!/usr/bin/env node

const fs = require('fs')
const path = require('path')

const CONVERGE_ROOT = path.resolve(__dirname)

function printHeader() {
  console.log('')
  console.log('  converge — 社内要件定義の収束スキル for Claude Code')
  console.log('')
}

function setup() {
  printHeader()

  // 1. SKILL.md の存在確認
  const skillPath = path.join(CONVERGE_ROOT, 'SKILL.md')
  if (!fs.existsSync(skillPath)) {
    console.error('  エラー: templates/SKILL.md が見つかりません')
    process.exit(1)
  }
  console.log('  [1/2] スキルファイルを確認...')
  console.log(`    → ${CONVERGE_ROOT}`)

  // 2. インストール先の確認
  const expectedDir = path.join(
    process.env.HOME || process.env.USERPROFILE,
    '.claude',
    'skills',
    'converge'
  )
  console.log('  [2/2] インストール先を確認...')
  if (CONVERGE_ROOT === expectedDir) {
    console.log('    → OK: ~/.claude/skills/converge/ に配置済み')
  } else {
    console.log(`    → 注意: 現在 ${CONVERGE_ROOT} にあります`)
    console.log(`    → Claude Code がスキルを認識するには ~/.claude/skills/converge/ に配置が必要です`)
    console.log(`    → 移動するか、以下のコマンドで再インストールしてください:`)
    console.log(`      rm -rf ${expectedDir}`)
    console.log(`      git clone --single-branch --depth 1 git@github.com:hosty-inhouse/converge.git ${expectedDir}`)
  }

  console.log('')
  console.log('  セットアップ完了!')
  console.log('')
  console.log('  使い方:')
  console.log('    Claude Code で /converge と入力するだけ')
  console.log('')
  console.log('  プロジェクトへの配置 (チームで使う場合):')
  console.log(`    node ${path.join(expectedDir, 'bin', 'converge')} init`)
  console.log('')
  console.log('  アップデート:')
  console.log(`    cd ${expectedDir} && git pull`)
  console.log('')
  console.log('  アンインストール:')
  console.log(`    rm -rf ${expectedDir}`)
  console.log('')
}

try {
  setup()
} catch (error) {
  console.error('  セットアップに失敗しました:', error.message)
  process.exit(1)
}
